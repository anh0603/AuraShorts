{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/storage/artifacts/**": true,
    "**/storage/media/**": true,
    "**/frontend/dist/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/storage/artifacts": true,
    "**/storage/media": true,
    "**/frontend/dist": true,
    "**/.venv": true,
    "**/__pycache__": true
  },
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000
}
